# secrets — never commit
.env
.env.*
!.env.example

# per-client intake bulk (ALL captures, any folder name: crawl/, crawl-b2b/,
# cvi/ ...) but KEEP the audit-trail files at intake root. Near-miss lesson:
# enumerating folder names let a second capture dir (crawl-b2b) go untracked.
intake/*
!intake/reconciliation.md
!intake/components-inventory.md
!intake/cvi-rules.json
# licensed binaries stay untracked; the rights manifest is audit trail
!intake/licensed/
intake/licensed/*
!intake/licensed/LICENSES.md
molslinjen/

# per-client access allowlist (PII — provisioned to the edge, never committed)
access.config.json

# build + deps
node_modules/
build/
dist/
.cache/

# OS noise
.DS_Store
Thumbs.db

# server and tool logs
*.log

# field/: filtered snapshots of client test runs, kept local for reference
# and dev logs. Client brand material never goes to the public repo; only
# the index is committed.
field/*
!field/INDEX.md

# generated
.react-router/
output/
