{
  "name": "brandos-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "brandos-mcp": "scripts/mcp-server.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run build:tokens && react-router build && node scripts/build-ai.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "generate-theme": "node scripts/generate-theme.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "preview": "npx serve output/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "validate": "npm run build:tokens && npm run typecheck && node scripts/validate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-router/node": "^7.18.2",
    "isbot": "^5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
  }
}
