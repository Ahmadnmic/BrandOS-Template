{
  "$description": "Odense Basket brand tokens. DTCG format. ref = raw palette, sys = roles (theming happens here, light/dark contexts), comp = component bindings. Print truth lives in $extensions under com.nm.brandos.print.",
  "ref": {
    "$type": "color",
    "dybhav": {
      "$value": "#0A1526",
      "$extensions": {
        "com.nm.brandos.print": {
          "pmsC": "296 C",
          "pmsU": "296 U",
          "cmyk": "96 79 43 60",
          "ral": "5004"
        }
      }
    },
    "is": {
      "$value": "#BFD9F2",
      "$extensions": {
        "com.nm.brandos.print": {
          "pmsC": "545 C",
          "pmsU": "545 U",
          "cmyk": "24 7 0 0"
        }
      }
    },
    "kridt": {
      "$value": "#F4F7FB",
      "$extensions": { "com.nm.brandos.print": { "cmyk": "3 1 0 0" } }
    },
    "signal": {
      "$value": "#E8B84B",
      "$extensions": {
        "com.nm.brandos.print": {
          "pmsC": "142 C",
          "pmsU": "142 U",
          "cmyk": "8 28 80 0"
        }
      }
    },
    "nat": { "$value": "#060D18" },
    "panel": { "$value": "#0E1E36" },
    "line-dark": { "$value": "#1D3050" },
    "line-light": { "$value": "#D6E0EC" },
    "dim-dark": { "$value": "#6C82A3" },
    "dim-light": { "$value": "#5E7292" },
    "panel-light": { "$value": "#FFFFFF" },
    "signal-deep": { "$value": "#8A6407" }
  },
  "sys": {
    "color": {
      "$type": "color",
      "surface": {
        "$value": { "light": "{ref.kridt}", "dark": "{ref.dybhav}" }
      },
      "panel": {
        "$value": { "light": "{ref.panel-light}", "dark": "{ref.panel}" }
      },
      "ink": { "$value": { "light": "{ref.dybhav}", "dark": "#F2F6FC" } },
      "dim": {
        "$value": { "light": "{ref.dim-light}", "dark": "{ref.dim-dark}" }
      },
      "line": {
        "$value": { "light": "{ref.line-light}", "dark": "{ref.line-dark}" }
      },
      "action": { "$value": { "light": "{ref.dybhav}", "dark": "{ref.is}" } },
      "on-action": {
        "$value": { "light": "{ref.kridt}", "dark": "{ref.dybhav}" }
      },
      "accent": { "$value": { "light": "#12335C", "dark": "{ref.is}" } },
      "signal": {
        "$value": { "light": "{ref.signal-deep}", "dark": "{ref.signal}" }
      },
      "on-signal": {
        "$value": { "light": "{ref.kridt}", "dark": "{ref.dybhav}" }
      }
    },
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "'JetBrains Mono Variable', 'JetBrains Mono', Consolas, monospace"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "'Public Sans', 'Segoe UI', Arial, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'JetBrains Mono Variable', 'JetBrains Mono', Consolas, monospace"
      }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "3px" },
      "md": { "$value": "6px" },
      "lg": { "$value": "8px" }
    },
    "space": { "$type": "number", "scale": { "$value": 0.9 } },
    "case": { "display": { "$value": "uppercase" } },
    "tracking": {
      "display": { "$value": "0.08em" },
      "label": { "$value": "0.16em" }
    },
    "motion": {
      "$description": "Derived from site evidence: Odense Basket's live surfaces move fast and settle hard (rolig-kinetisk 0.7). Durations are short, easings decisive.",
      "duration-instant": { "$type": "duration", "$value": "80ms" },
      "duration-fast": { "$type": "duration", "$value": "140ms" },
      "duration-base": { "$type": "duration", "$value": "220ms" },
      "duration-slow": { "$type": "duration", "$value": "360ms" },
      "ease-out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "ease-in": { "$type": "cubicBezier", "$value": [0.55, 0, 0.85, 0.36] },
      "ease-in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
      "ease-emphasized": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "distance-sm": { "$type": "dimension", "$value": "6px" },
      "distance-md": { "$type": "dimension", "$value": "14px" }
    },
    "composition": {
      "$description": "Layout evidence from the site AND the CVI document's own editorial layout. The portal's structure follows these, so layout changes from build to build.",
      "containment": { "$value": "ruled" },
      "alignment": { "$value": "flush-left" },
      "coverStyle": { "$value": "mark-led" },
      "imageWeight": { "$value": "balanced" },
      "rhythm": { "$value": "alternating" }
    },
    "theme": {
      "$description": "The brand's native appearance. STANDARD in the portal resolves to this; lys and moerk are contrast views.",
      "default": { "$value": "dark" }
    }
  },
  "$extensions": {
    "com.nm.brandos.profile": {
      "skarp-blod": 0.15,
      "taet-luftig": 0.35,
      "teknisk-menneskelig": 0.2,
      "rolig-kinetisk": 0.7,
      "raa-poleret": 0.3,
      "bokset-aaben": 0.4
    }
  }
}
